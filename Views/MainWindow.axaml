<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WMS.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="WMS.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="WMS"
        MinWidth="800" MinHeight="500">

    <Window.Styles>
        <Style Selector="ListBoxItem.NavItem">
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="220,*">

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- App Title -->
                <Border DockPanel.Dock="Top" Padding="20,22,20,14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="WMS" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Warehouse Management" FontSize="11" Opacity="0.5"/>
                    </StackPanel>
                </Border>

                <Separator DockPanel.Dock="Top" Margin="16,0,16,6" Opacity="0.25"/>

                <!-- Nav Items -->
                <ListBox x:Name="NavList"
                         DockPanel.Dock="Top"
                         Background="Transparent"
                         Margin="4,2"
                         SelectedIndex="0"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Classes="NavItem" Tag="Dashboard">
                        <TextBlock Text="Dashboard"/>
                    </ListBoxItem>
                    <ListBoxItem Classes="NavItem" Tag="Products">
                        <TextBlock Text="Products"/>
                    </ListBoxItem>
                    <ListBoxItem Classes="NavItem" Tag="Orders">
                        <TextBlock Text="Orders"/>
                    </ListBoxItem>
                    <ListBoxItem Classes="NavItem" Tag="Customers">
                        <TextBlock Text="Customers"/>
                    </ListBoxItem>
                    <ListBoxItem Classes="NavItem" Tag="Documents">
                        <TextBlock Text="Dokumenty mag."/>
                    </ListBoxItem>
                </ListBox>

            </DockPanel>
        </Border>

        <!-- Content Area with CrossFade transition -->
        <TransitioningContentControl Grid.Column="1"
                                     Content="{Binding CurrentPage}">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.18"/>
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

    </Grid>

</Window>
