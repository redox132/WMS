<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WMS.ViewModels.Pages"
             x:Class="WMS.Views.Pages.CustomersPageView"
             x:DataType="vm:CustomersPageViewModel"
             x:CompileBindings="False">

    <DockPanel Margin="32,28">

        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="Customers" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Customers, suppliers and trading partners" Opacity="0.55" FontSize="14"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ New Customer" VerticalAlignment="Bottom" Padding="14,8" CornerRadius="6" Click="AddCustomer_Click"/>
        </Grid>

        <!-- Toolbar -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,200" Margin="0,0,0,14">
            <TextBox Grid.Column="0" Watermark="Search name, tax ID or email…"
                     Text="{Binding SearchText}" Margin="0,0,10,0" CornerRadius="6"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding RoleFilters}"
                      SelectedItem="{Binding RoleFilter}" HorizontalAlignment="Stretch"/>
        </Grid>

        <!-- Table -->
        <Border CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <StackPanel>
                <Border Padding="16,12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,110,135,90,75,70">
                        <TextBlock Text="Name"         FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                        <TextBlock Grid.Column="1" Text="Tax ID"      FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                        <TextBlock Grid.Column="2" Text="Email"        FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                        <TextBlock Grid.Column="3" Text="City"         FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                        <TextBlock Grid.Column="4" Text="Pay. days"    FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                        <TextBlock Grid.Column="5" Text="Role"         FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Customers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,13" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,110,135,90,75,70">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13"/>
                                        <TextBlock Text="{Binding ShortName}" FontSize="11" Opacity="0.45"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding TaxId}"   FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Email}"   FontSize="12" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding City}"    VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding PaymentTermDays, StringFormat={}{0} days}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding TypeLabel}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </DockPanel>
</UserControl>
