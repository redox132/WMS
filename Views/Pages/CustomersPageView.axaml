<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WMS.ViewModels.Pages"
             xmlns:m="using:WMS.Models"
             x:Class="WMS.Views.Pages.CustomersPageView"
             x:DataType="vm:CustomersPageViewModel"
             x:CompileBindings="False">

    <DockPanel Margin="32,28">

        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,24">
            <StackPanel Spacing="4">
                <TextBlock Text="Kontrahenci" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Odbiorcy, dostawcy i partnerzy handlowi" Opacity="0.55" FontSize="14"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ Nowy kontrahent" VerticalAlignment="Bottom"
                    Padding="14,8" CornerRadius="6"/>
        </Grid>

        <!-- Table -->
        <Border CornerRadius="10"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <StackPanel>
                <!-- Headers -->
                <Border Padding="16,12"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,110,120,110,80,70">
                        <TextBlock Text="Nazwa" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                        <TextBlock Grid.Column="1" Text="NIP" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                        <TextBlock Grid.Column="2" Text="E-mail" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                        <TextBlock Grid.Column="3" Text="Miasto" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                        <TextBlock Grid.Column="4" Text="Termin płat." FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                        <TextBlock Grid.Column="5" Text="Rola" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                    </Grid>
                </Border>
                <!-- Rows -->
                <ItemsControl ItemsSource="{Binding Customers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,13"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,110,120,110,80,70">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13"/>
                                        <TextBlock Text="{Binding ShortName}" FontSize="11" Opacity="0.45"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding NIP}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Email}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding City}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding PaymentTermDays, StringFormat={}{0} dni}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding TypeLabel}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </DockPanel>

</UserControl>
