<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WMS.ViewModels.Pages"
             x:Class="WMS.Views.Pages.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel"
             x:CompileBindings="False">

    <ScrollViewer Padding="32,28,32,0">
        <StackPanel Spacing="20" Margin="0,0,0,28">

            <StackPanel Spacing="4">
                <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Company profile, appearance and system info" Opacity="0.55" FontSize="14"/>
            </StackPanel>

            <!-- ── Two-column layout ──────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,20,360" VerticalAlignment="Top">

                <!-- LEFT: Company Information -->
                <Border Grid.Column="0" Padding="24" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Company Information" FontSize="16" FontWeight="SemiBold"/>

                        <!-- Identity -->
                        <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,12,Auto,12,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Company Name *" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding CompanyName}" PlaceholderText="e.g. Acme Sp. z o.o." CornerRadius="6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                <TextBlock Text="Legal Form" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding LegalForm}" PlaceholderText="Sp. z o.o., S.A., …" CornerRadius="6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Short Name" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding ShortName}" PlaceholderText="Abbreviation / trade name" CornerRadius="6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
                                <TextBlock Text="NIP (Tax ID)" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding TaxId}" PlaceholderText="000-000-00-00" CornerRadius="6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="0" Spacing="4">
                                <TextBlock Text="EU VAT Number" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding VatNumber}" PlaceholderText="PL0000000000" CornerRadius="6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2" Spacing="4">
                                <TextBlock Text="REGON" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding Regon}" PlaceholderText="9-digit REGON" CornerRadius="6"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="KRS" FontSize="12" Opacity="0.6"/>
                            <TextBox Text="{Binding Krs}" PlaceholderText="Court register number" CornerRadius="6"/>
                        </StackPanel>

                        <!-- Address -->
                        <TextBlock Text="Address" FontSize="13" FontWeight="Medium" Margin="0,4,0,0"/>
                        <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,12,Auto,12,Auto">
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Spacing="4">
                                <TextBlock Text="Street" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding Street}" PlaceholderText="Street and number" CornerRadius="6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Postal Code" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding PostalCode}" PlaceholderText="00-000" CornerRadius="6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
                                <TextBlock Text="City" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding City}" PlaceholderText="City" CornerRadius="6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="0" Spacing="4">
                                <TextBlock Text="State / Province" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding State}" PlaceholderText="Optional" CornerRadius="6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2" Spacing="4">
                                <TextBlock Text="Country" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding Country}" PlaceholderText="PL" CornerRadius="6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Contact -->
                        <TextBlock Text="Contact" FontSize="13" FontWeight="Medium" Margin="0,4,0,0"/>
                        <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,12,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Phone" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding Phone}" PlaceholderText="+48 000 000 000" CornerRadius="6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                <TextBlock Text="Email" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding Email}" PlaceholderText="contact@company.com" CornerRadius="6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Spacing="4">
                                <TextBlock Text="Website" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding Website}" PlaceholderText="https://www.company.com" CornerRadius="6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Bank -->
                        <TextBlock Text="Bank Account" FontSize="13" FontWeight="Medium" Margin="0,4,0,0"/>
                        <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,12,Auto">
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Spacing="4">
                                <TextBlock Text="Account Number / IBAN" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding BankAccount}" PlaceholderText="PL00 0000 0000 0000 0000 0000 0000" CornerRadius="6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Bank Name" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding BankName}" PlaceholderText="e.g. PKO BP" CornerRadius="6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
                                <TextBlock Text="SWIFT / BIC" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding BankSwift}" PlaceholderText="BPKOPLPW" CornerRadius="6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Document defaults -->
                        <TextBlock Text="Document Defaults" FontSize="13" FontWeight="Medium" Margin="0,4,0,0"/>
                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Currency" FontSize="12" Opacity="0.6"/>
                                <TextBox Text="{Binding Currency}" PlaceholderText="PLN" CornerRadius="6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Payment Term (days)" FontSize="12" Opacity="0.6"/>
                                <NumericUpDown Value="{Binding PaymentTermDays}" Minimum="0" Maximum="365"
                                               FormatString="0" CornerRadius="6"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Invoice Footer Note" FontSize="12" Opacity="0.6"/>
                            <TextBox Text="{Binding InvoiceFooter}" PlaceholderText="e.g. Thank you for your business!"
                                     CornerRadius="6" Height="68" AcceptsReturn="True" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Save -->
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                            <Button Content="Save Company Info" Padding="16,9" CornerRadius="6"
                                    Background="#0078D4" Foreground="White"
                                    Command="{Binding SaveCompanyCommand}"/>
                            <TextBlock Text="{Binding SaveMessage}" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- RIGHT: Appearance + Database + About -->
                <StackPanel Grid.Column="2" Spacing="16">

                    <!-- Appearance -->
                    <Border Padding="24" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Dark Mode" FontSize="14"/>
                                    <TextBlock Text="Switch between light and dark theme" FontSize="12" Opacity="0.55"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDarkTheme}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Database -->
                    <Border Padding="24" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Database" FontSize="16" FontWeight="SemiBold"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Location" FontSize="12" Opacity="0.6"/>
                                <TextBlock Text="{Binding DatabasePath}" FontSize="11" TextWrapping="Wrap" Opacity="0.75"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Open Folder" Padding="12,7" CornerRadius="6"/>
                                <Button Content="Backup DB"   Padding="12,7" CornerRadius="6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- About -->
                    <Border Padding="24" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="About" FontSize="16" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                <TextBlock Text="Application" Opacity="0.6" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="WMS" FontSize="13"/>
                                <TextBlock Grid.Row="1" Text="Version" Opacity="0.6" FontSize="13"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AppVersion}" FontSize="13"/>
                                <TextBlock Grid.Row="2" Text="Platform" Opacity="0.6" FontSize="13"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Avalonia UI" FontSize="13"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
