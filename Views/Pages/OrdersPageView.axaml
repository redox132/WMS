<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WMS.ViewModels.Pages"
             x:Class="WMS.Views.Pages.OrdersPageView"
             x:DataType="vm:OrdersPageViewModel"
             x:CompileBindings="False">

    <DockPanel Margin="32,28">

        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="Orders" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Sales orders (SO) and purchase orders (PO)" Opacity="0.55" FontSize="14"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ New Order" VerticalAlignment="Bottom" Padding="14,8" CornerRadius="6" Click="AddOrder_Click"/>
        </Grid>

        <!-- Toolbar -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,160,180" Margin="0,0,0,14">
            <TextBox Grid.Column="0" Watermark="Search order number or customer…"
                     Text="{Binding SearchText}" Margin="0,0,10,0" CornerRadius="6"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding TypeFilters}"
                      SelectedItem="{Binding TypeFilter}" Margin="0,0,10,0" HorizontalAlignment="Stretch"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding StatusFilters}"
                      SelectedItem="{Binding StatusFilter}" HorizontalAlignment="Stretch"/>
        </Grid>

        <!-- Table -->
        <Border CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <StackPanel>
                <Border Padding="16,12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="44,150,*,105,105,90">
                        <TextBlock Text="Type"           FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                        <TextBlock Grid.Column="1" Text="Number"         FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                        <TextBlock Grid.Column="2" Text="Customer"       FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                        <TextBlock Grid.Column="3" Text="Date"           FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                        <TextBlock Grid.Column="4" Text="Value (gross)"  FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                        <TextBlock Grid.Column="5" Text="Status"         FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Orders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,13" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="44,150,*,105,105,90">
                                    <Border CornerRadius="4" Padding="5,2" Background="{Binding TypeColor}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Number}"      FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CustomerName}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding OrderDate, StringFormat={}{0:dd MMM yyyy}}" Opacity="0.7" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding GrossAmount,  StringFormat={}{0:N2}}" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <Border Grid.Column="5" CornerRadius="4" Padding="6,3" Background="{Binding StatusColor}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </DockPanel>
</UserControl>
