<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WMS.Views.UpdateDialog"
        Title="Software Update"
        Width="460" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="28,24" Spacing="14">

        <TextBlock x:Name="MessageText" FontSize="14" TextWrapping="Wrap"/>

        <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Height="14"
                     IsVisible="False" CornerRadius="4"/>

        <TextBlock x:Name="ProgressText" FontSize="11" Opacity="0.6"
                   IsVisible="False" HorizontalAlignment="Right"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click"/>
            <Button x:Name="ActionButton" Content="Download" Click="Action_Click"
                    Background="#0078D4" Foreground="White" Padding="16,6" CornerRadius="4"/>
        </StackPanel>

    </StackPanel>
</Window>
